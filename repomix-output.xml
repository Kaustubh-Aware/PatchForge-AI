}

.progress-fill{

  width:100%;

  height:100%;

  border-radius:20px;

  background:linear-gradient(
      90deg,
      #3b82f6,
      #06b6d4,
      #8b5cf6
  );

  background-size:200%;

  animation:moveGradient 4s linear infinite;

}

@keyframes moveGradient{

  0%{

      background-position:0%;

  }

  100%{

      background-position:200%;

  }

}

.count-up-text{

  font-weight:700;

  font-size:3rem;

}

@media(max-width:900px){

.stats-grid{

grid-template-columns:1fr;

}

}

.stat-card::after{

content:"";

position:absolute;

top:-150%;

left:-50%;

width:50%;

height:400%;

background:linear-gradient(

90deg,

transparent,

rgba(255,255,255,.08),

transparent

);

transform:rotate(25deg);

animation:shine 7s linear infinite;

pointer-events:none;

}

@keyframes shine{

0%{

left:-70%;

}

100%{

left:170%;

}

}

.ai-card{

animation:aiPulse 3s ease-in-out infinite;

}

@keyframes aiPulse{

0%{

box-shadow:
0 0 0 rgba(124,58,237,0);

}

50%{

box-shadow:
0 0 35px rgba(124,58,237,.18);

}

100%{

box-shadow:
0 0 0 rgba(124,58,237,0);

}

}

.stat-card span.floating-dot{

position:absolute;

width:7px;

height:7px;

border-radius:50%;

background:#60a5fa;

opacity:.25;

animation:floatDot 8s linear infinite;

}

@keyframes floatDot{

0%{

transform:
translateY(40px);

opacity:0;

}

30%{

opacity:.4;

}

100%{

transform:
translateY(-180px);

opacity:0;

}

}
