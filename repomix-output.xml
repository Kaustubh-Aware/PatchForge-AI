                style={{ cursor: "pointer" }}
              >
                <div className="scan-left">
                  <div className="repo-icon">
                    <GitBranch size={22} />
                  </div>

                  <div>
                    <h3>{repoName}</h3>
                    <span>{scan.scanId}</span>
                  </div>
                </div>

