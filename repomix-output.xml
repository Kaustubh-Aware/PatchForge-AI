/* ==========================================================
   PATCHFORGE AI • PREMIUM FLOATING SIDEBAR
========================================================== */

:root{

    --sidebar-bg:#0b1120;
    --sidebar-card:#111827;

    --cyan:#06b6d4;
    --blue:#2563eb;
    --purple:#7c3aed;

    --text:#ffffff;
    --muted:#94a3b8;

}

/* ==========================================================
   FLOATING BUTTON
========================================================== */

.floating-toggle{

    position:fixed;

    top:108px;
    left:30px;

    width:62px;
    height:62px;

    border:none;

    border-radius:20px;

    display:flex;
    justify-content:center;
    align-items:center;

    cursor:pointer;

    color:white;

   background:linear-gradient(
    135deg,
    #f97316,
    #ef4444
);

box-shadow:
    0 18px 45px rgba(239,68,68,.35),
    0 0 35px rgba(249,115,22,.28);

    transition:.35s;

    z-index:9999;

}

.floating-toggle:hover{

    transform:
        translateY(-4px)
        scale(1.05);

    box-shadow:
        0 22px 55px rgba(239,68,68,.45),
        0 0 40px rgba(249,115,22,.35);

}

.floating-toggle.opened{

    transform:rotate(90deg);

}

/* ==========================================================
   OVERLAY
========================================================== */

.floating-overlay{

    position:fixed;

    inset:0;

    background:
        rgba(3,7,18,.62);

    backdrop-filter:blur(10px);

    z-index:9990;

    animation:fade .35s ease;

}

@keyframes fade{

    from{

        opacity:0;

    }

    to{

        opacity:1;

    }

}

/* ==========================================================
   SIDEBAR
========================================================== */

.floating-sidebar{

    position:fixed;

    top:95px;
    left:24px;

    width:330px;

    height:calc(100vh - 120px);

    border-radius:28px;

    background:
        linear-gradient(
            180deg,
            rgba(15,23,42,.98),
            rgba(8,12,24,.98)
        );

    border:1px solid rgba(255,255,255,.07);

    backdrop-filter:blur(28px);

    box-shadow:

        0 30px 70px rgba(0,0,0,.55),

        inset 0 1px 0 rgba(255,255,255,.05);

    display:flex;

    flex-direction:column;

    overflow:hidden;

    transform:
        translateX(-120%);

    opacity:0;

    transition:
        transform .45s cubic-bezier(.2,.8,.2,1),
        opacity .4s;

    z-index:9995;

}

.floating-sidebar.show{

    transform:translateX(0);

    opacity:1;

}

/* ==========================================================
   CLOSE BUTTON
========================================================== */

.sidebar-close{

    position:absolute;

    right:20px;
    top:20px;

    z-index:20;

    width:40px;
    height:40px;

    border:none;

    border-radius:12px;

    background:rgba(255,255,255,.05);

    color:#dbeafe;

    cursor:pointer;

    transition:.3s;

}

.sidebar-close:hover{

    background:#ef4444;

    color:white;

