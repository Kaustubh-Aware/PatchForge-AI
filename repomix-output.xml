                      </span>
                    </td>
                    <td className="cvss-score">
                      {item.cvssScore > 0 ? item.cvssScore.toFixed(1) : "—"}
                    </td>
                    <td className="vuln-id">{item.vulnerabilityId || "—"}</td>
                    <td>{item.fixedVersion || "N/A"}</td>
                    <td className="expand-icon">
                      {isExpanded ? <ChevronUp size={16} /> : <ChevronDown size={16} />}
                    </td>
                  </tr>

                  {isExpanded && (
                    <tr className="vuln-detail-row">
                      <td colSpan={7}>
                        <div className="vuln-detail">
                          <div className="detail-section">
                            <strong>Summary</strong>
                            <p>{item.summary || "No summary available."}</p>
                          </div>

                          {item.references && item.references.length > 0 && (
                            <div className="detail-section">
                              <strong>References</strong>
                              <ul className="ref-list">
                                {item.references.slice(0, 5).map((ref, i) => (
                                  <li key={i}>
                                    <a
                                      href={ref}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      onClick={(e) => e.stopPropagation()}
                                    >
                                      {ref}
                                      <ExternalLink size={12} />
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            </div>
                          )}
                        </div>
                      </td>
                    </tr>
                  )}
                </Fragment>
              );
            })}
          </tbody>
        </table>
      </div>

      {/* Pagination */}
      {totalPages > 1 && (
        <div className="vuln-pagination">
          <span className="page-info">
            Showing {(page - 1) * ITEMS_PER_PAGE + 1}–{Math.min(page * ITEMS_PER_PAGE, filtered.length)} of {filtered.length}
          </span>
          <div className="page-controls">
            <button
              disabled={page === 1}
              onClick={() => setPage((p) => Math.max(1, p - 1))}
            >
              <ChevronLeft size={16} />
            </button>
            <span>Page {page} of {totalPages}</span>
            <button
              disabled={page === totalPages}
              onClick={() => setPage((p) => Math.min(totalPages, p + 1))}
            >
              <ChevronRight size={16} />
            </button>
          </div>
        </div>
      )}
    </div>
  );
};

export default VulnerabilityTable;
