<file path="frontend/src/components/ui/Button/Button.css">
/* ==========================================================
   PATCHFORGE AI BUTTON
   ========================================================== */

.pf-button {
  --pf-blue: #3b82f6;
  --pf-cyan: #06b6d4;
  --pf-purple: #8b5cf6;
  --pf-green: #22c55e;
  --pf-red: #ef4444;
  --pf-orange: #f59e0b;

  position: relative;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  overflow: hidden;

  cursor: pointer;

  border: none;

  outline: none;

  isolation: isolate;

  transition: all 0.35s ease;

  font-weight: 600;

  letter-spacing: 0.4px;

  color: white;

  user-select: none;

  background: transparent;
}

/* ============================================= */

.pf-content {

  position: relative;

  z-index: 5;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 12px;
}

/* ============================================= */

.pf-text {

  white-space: nowrap;
}

.pf-icon {

  display: flex;

  align-items: center;

  justify-content: center;
}

/* ============================================= */

.pf-full-width {

  width: 100%;
}

.pf-rounded {

  border-radius: 999px;
}

.pf-button:not(.pf-rounded) {

  border-radius: 16px;
}

/* ==========================================================
   SIZES
   ========================================================== */

.pf-sm {

  padding: 10px 20px;

  font-size: 14px;
}

.pf-md {

  padding: 14px 28px;

  font-size: 15px;
}

.pf-lg {

  padding: 18px 38px;

  font-size: 16px;
}

/* ==========================================================
   GLOW
   ========================================================== */

.pf-glow {

  position: absolute;

  inset: -40%;

  border-radius: inherit;

  opacity: 0;

  transition: .35s;

  filter: blur(35px);

  z-index: 0;
}

.pf-button:hover .pf-glow {

  opacity: .85;
}

/* ==========================================================
   BORDER
   ========================================================== */

.pf-border {

  position: absolute;

  inset: 0;

  border-radius: inherit;

  padding: 1px;

  background: linear-gradient(
      135deg,
      transparent,
      rgba(255,255,255,.45),
      transparent
  );

  mask:
    linear-gradient(#fff 0 0) content-box,
    linear-gradient(#fff 0 0);

  mask-composite: exclude;

  -webkit-mask:
    linear-gradient(#fff 0 0) content-box,
    linear-gradient(#fff 0 0);

  -webkit-mask-composite: xor;

  opacity: .5;

  transition: .35s;
}

.pf-button:hover .pf-border {

  opacity: 1;
}

/* ==========================================================
   SHINE EFFECT
   ========================================================== */

.pf-shine {

  position: absolute;

  top: -120%;

  left: -40%;

  width: 40%;

  height: 300%;

  background: linear-gradient(
      90deg,
      transparent,
      rgba(255,255,255,.28),
      transparent
  );

  transform: rotate(25deg);

  transition: .8s;

  z-index: 2;

}

.pf-button:hover .pf-shine {

  left: 130%;

}

/* ==========================================================
   PRIMARY
   ========================================================== */

.pf-primary {

  background:
      linear-gradient(
          135deg,
          #2563eb,
          #06b6d4
      );

  box-shadow:
      0 10px 30px rgba(37,99,235,.22);

}

.pf-primary .pf-glow {

  background:

      radial-gradient(

          circle,

          rgba(37,99,235,.65),

          transparent 70%

      );

}

.pf-primary:hover {

  transform:
      translateY(-3px)
      scale(1.015);

}

/* ==========================================================
   AI BUTTON
   ========================================================== */

.pf-ai {

  background:

      linear-gradient(
          135deg,
          #2563eb,
          #8b5cf6,
          #06b6d4
      );

  background-size: 250%;

  animation:
      aiGradient 6s linear infinite;

  box-shadow:

      0 12px 40px rgba(139,92,246,.25);

}

.pf-ai .pf-glow {

  background:

      radial-gradient(

          circle,

          rgba(168,85,247,.65),

          transparent 70%

      );

}

.pf-ai:hover {

  transform:

      translateY(-4px)

      scale(1.02);

}

/* ==========================================================
   SECONDARY
   ========================================================== */

.pf-secondary {

  background:

      linear-gradient(

          135deg,

          #7c3aed,

          #6d28d9

      );

}

.pf-secondary .pf-glow {

  background:

      radial-gradient(

          circle,

          rgba(124,58,237,.6),

          transparent 70%

      );

}

/* ==========================================================
   SUCCESS
   ========================================================== */

.pf-success {

  background:

      linear-gradient(

          135deg,

          #22c55e,

          #16a34a

      );

}

.pf-success .pf-glow {

  background:

      radial-gradient(

          circle,

          rgba(34,197,94,.55),

          transparent 70%

      );

}

/* ==========================================================
   DANGER
   ========================================================== */

.pf-danger {

  background:

      linear-gradient(

          135deg,

          #ef4444,

          #dc2626

      );

}

.pf-danger .pf-glow {

  background:

      radial-gradient(

          circle,

          rgba(239,68,68,.6),

          transparent 70%

      );

}

/* ==========================================================
   GHOST
   ========================================================== */

.pf-ghost {

  background:

      rgba(255,255,255,.04);

  backdrop-filter: blur(16px);

  -webkit-backdrop-filter: blur(16px);

  border:

      1px solid rgba(255,255,255,.08);

}

.pf-ghost .pf-glow {

  background:

      radial-gradient(

          circle,

          rgba(59,130,246,.35),

          transparent 75%

      );

}

.pf-ghost:hover {

  background:

      rgba(255,255,255,.07);

  transform:

      translateY(-3px);

}

/* ==========================================================
   LOADER
   ========================================================== */

.pf-loader {

  width: 18px;

  height: 18px;

  border-radius: 50%;

  border: 2px solid rgba(255,255,255,.35);

  border-top-color: white;

  animation: spin .8s linear infinite;

}

.pf-loading-text {

  letter-spacing: .4px;

}

/* ==========================================================
   ANIMATIONS
   ========================================================== */

@keyframes spin {

  to {

      transform: rotate(360deg);

  }

}

@keyframes aiGradient {

  0% {

      background-position: 0%;

  }

  100% {

      background-position: 250%;

  }

}

/* ==========================================================
   FOCUS STATE
   ========================================================== */

.pf-button:focus-visible {

  outline: none;

  box-shadow:
      0 0 0 3px rgba(59,130,246,.35),
      0 0 30px rgba(59,130,246,.30);

}

.pf-button:disabled {

  cursor: not-allowed;

  opacity: .6;

  transform: none !important;

}

.pf-button:disabled .pf-glow {

  opacity: .15;

}

/* ==========================================================
   RIPPLE
   ========================================================== */

.pf-ripple {

  position: absolute;

  inset: 0;

  overflow: hidden;

  border-radius: inherit;

  z-index: 1;

}

.pf-button::after {

  content: "";

  position: absolute;

  width: 18px;

  height: 18px;

  border-radius: 50%;

  background: rgba(255,255,255,.18);

  transform: scale(0);

  opacity: 0;

  pointer-events: none;

}

.pf-button:active::after {

  animation: ripple .55s ease-out;

}

@keyframes ripple {

  0% {

      transform: scale(0);

      opacity: .8;

  }

  100% {

      transform: scale(18);

      opacity: 0;

  }

}

/* ==========================================================
   AI BREATHING
   ========================================================== */

.pf-ai {

  animation:
      aiGradient 6s linear infinite,
      aiBreath 3s ease-in-out infinite;

}

@keyframes aiBreath {

  0% {

      box-shadow:
          0 0 18px rgba(59,130,246,.20);

  }

  50% {

      box-shadow:
          0 0 34px rgba(139,92,246,.42);

  }

  100% {

      box-shadow:
          0 0 18px rgba(59,130,246,.20);

  }

}

/* ==========================================================
   REFLECTION
   ========================================================== */

.pf-button::before {

  content: "";

  position: absolute;

  top: 0;

  left: -120%;

  width: 45%;

  height: 100%;

  background:

      linear-gradient(

          90deg,

          transparent,

          rgba(255,255,255,.18),

          transparent

      );

  transform: skewX(-22deg);

  transition: .9s;

}

.pf-button:hover::before {

  left: 160%;

}

/* ==========================================================
   HOVER
   ========================================================== */

.pf-button:hover {

  filter:

      brightness(1.05)

      saturate(1.08);

}

.pf-button:active {

  transform:

      scale(.97);

}

/* ==========================================================
   MOBILE
   ========================================================== */

@media (max-width:768px){

.pf-lg{

padding:16px 28px;

font-size:15px;

}

.pf-md{

padding:13px 24px;

}

}

/* ==========================================================
   ACCESSIBILITY
   ========================================================== */

@media (prefers-reduced-motion: reduce){

*{

animation:none !important;

transition:none !important;

}

}

/* ==========================================================
   SHADOW
   ========================================================== */

.pf-button{

box-shadow:

0 12px 25px rgba(0,0,0,.25),

0 2px 6px rgba(255,255,255,.04) inset;

}
