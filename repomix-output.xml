import { useState, useMemo, Fragment } from "react";
import "./VulnerabilityTable.css";
import {
  Search,
  ChevronDown,
  ChevronUp,
  ExternalLink,
  Filter,
  ChevronLeft,
  ChevronRight,
} from "lucide-react";

const ITEMS_PER_PAGE = 10;

const VulnerabilityTable = ({ vulnerabilities }) => {
  const [search, setSearch] = useState("");
  const [severityFilter, setSeverityFilter] = useState("ALL");
  const [sortBy, setSortBy] = useState("severity");
  const [sortDir, setSortDir] = useState("desc");
  const [expandedRow, setExpandedRow] = useState(null);
  const [page, setPage] = useState(1);

  if (!vulnerabilities || vulnerabilities.length === 0) {
    return (
      <div className="vuln-table-container">
        <h2>Vulnerabilities</h2>
        <div className="vuln-empty">
          <p>No vulnerabilities found — this repository appears secure.</p>
        </div>
      </div>
    );
  }

  const severityOrder = { CRITICAL: 4, HIGH: 3, MEDIUM: 2, LOW: 1, UNKNOWN: 0 };

  // Filter + Search
  const filtered = useMemo(() => {
    let result = [...vulnerabilities];

    // Severity filter
    if (severityFilter !== "ALL") {
      result = result.filter(
        (v) => (v.severity || "").toUpperCase() === severityFilter
      );
    }

    // Search
    if (search.trim()) {
      const q = search.toLowerCase();
      result = result.filter(
        (v) =>
          (v.packageName || "").toLowerCase().includes(q) ||
          (v.vulnerabilityId || "").toLowerCase().includes(q) ||
          (v.summary || "").toLowerCase().includes(q)
      );
    }

    // Sort
    result.sort((a, b) => {
      let comparison = 0;

      if (sortBy === "severity") {
        comparison =
          (severityOrder[b.severity] || 0) - (severityOrder[a.severity] || 0);
      } else if (sortBy === "package") {
        comparison = (a.packageName || "").localeCompare(b.packageName || "");
      } else if (sortBy === "cvss") {
        comparison = (b.cvssScore || 0) - (a.cvssScore || 0);
      }

      return sortDir === "asc" ? -comparison : comparison;
    });

    return result;
  }, [vulnerabilities, severityFilter, search, sortBy, sortDir]);

  // Pagination
  const totalPages = Math.ceil(filtered.length / ITEMS_PER_PAGE);
  const paginated = filtered.slice(
    (page - 1) * ITEMS_PER_PAGE,
    page * ITEMS_PER_PAGE
  );

  const toggleSort = (field) => {
    if (sortBy === field) {
      setSortDir((d) => (d === "asc" ? "desc" : "asc"));
    } else {
      setSortBy(field);
      setSortDir("desc");
    }
  };

  const getSeverityClass = (severity) => {
    return (severity || "unknown").toLowerCase();
  };

  return (
    <div className="vuln-table-container">
      <div className="vuln-table-header">
        <h2>Vulnerabilities ({vulnerabilities.length})</h2>

        <div className="vuln-controls">
          {/* Search */}
          <div className="vuln-search">
            <Search size={16} />
            <input
              type="text"
              placeholder="Search packages, CVEs..."
              value={search}
              onChange={(e) => { setSearch(e.target.value); setPage(1); }}
            />
          </div>

          {/* Severity Filter */}
          <div className="vuln-filter">
            <Filter size={16} />
            <select
              value={severityFilter}
              onChange={(e) => { setSeverityFilter(e.target.value); setPage(1); }}
            >
              <option value="ALL">All Severities</option>
              <option value="CRITICAL">Critical</option>
              <option value="HIGH">High</option>
              <option value="MEDIUM">Medium</option>
              <option value="LOW">Low</option>
            </select>
          </div>
        </div>
      </div>

      <div className="vuln-table-wrapper">
        <table className="vuln-table">
          <thead>
            <tr>
              <th onClick={() => toggleSort("package")} className="sortable">
